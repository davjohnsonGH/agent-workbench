{
  "name": "agent-workbench",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "vitest",
    "test:run": "vitest run",
    "db:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "db:generate": "npm run db:generate -w @repo/db",
    "db:migrate": "npm run db:migrate -w @repo/db",
    "db:studio": "npm run db:studio -w @repo/db",
    "agent:pm": "tsx scripts/pm-run.ts",
    "worker": "npm run start -w worker"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2",
    "vitest": "^5.0.0",
    "tsx": "4.23.15"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11 <12"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
